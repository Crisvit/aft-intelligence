# Copia este archivo como variables de entorno en Easypanel (servicio
# hmt-intelligence). Nunca rellenes este archivo con valores reales ni lo
# subas a git — solo sirve de plantilla, .env está en .gitignore.

PORT=3000

# --- Panel (Basic Auth) ---
DASHBOARD_USER=
# Hash bcrypt de la contraseña, nunca el texto plano. Generarlo con:
#   node -e "console.log(require('bcryptjs').hashSync('TU_CONTRASEÑA', 10))"
DASHBOARD_PASSWORD_HASH=

# --- hmt-db (Postgres independiente, nuevo) ---
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSL=true

# --- AFT ---
AFT_API_BASE=https://apids.aftgrupo.com
AFT_TOKEN_URL=https://apids.aftgrupo.com/token
# JSON con el cuerpo EXACTO que espera el POST de token de AFT
# (grant_type/usuario/contraseña/client_id, lo que corresponda). Ejemplo:
#   {"grant_type":"password","username":"...","password":"...","client_id":"..."}
AFT_TOKEN_BODY_JSON=

# Listas configurables (CSV) para el control de oportunidades comerciales.
# Opcionales — si no se definen, se usan los valores de siempre.
# AFT_BRANDS=WOLFPACK,PAPILLON,SATURNIA,MAURER,SAMURAI,YAMATO
# AFT_BRANDS_PRIORITARIAS=WOLFPACK,SAMURAI,MAURER,PAPILLON,SATURNIA
# AFT_CATEGORIAS_INCLUIDAS=HERRAMIENTA,ELECTROPORTATIL,AMOLADORA,...
# Stock mínimo en AFT para que una referencia no encontrada en Shopify
# cuente como oportunidad real. Opcional, por defecto 1.
# AFT_STOCK_MINIMO_OPORTUNIDAD=1

# --- Agente de rentabilidad ---
# Umbral de margen bajo (%) y de diferencia de coste con Shopify (%) que
# disparan alerta. Opcionales, por defecto 15 y 20.
# RENTABILIDAD_MARGEN_BAJO_PCT=15
# RENTABILIDAD_DIFERENCIA_COSTE_PCT=20
# Comisión de venta (%), diferenciada en el desglose. 0 por defecto (sin
# inventar un porcentaje) — configurar solo con un dato real confirmado.
# RENTABILIDAD_COMISION_VENTA_PCT=0
# El transporte real ya NO se configura con una tarifa fija: se usa
# aft_catalogo.portes por referencia (confirmado con datos reales de AFT —
# envío directo). config_transporte_cliente (tabla en hmt-db, editable sin
# redeploy) solo aplica como respaldo propio para referencias SIN portes
# válido de AFT; su regla "default" (4,41€, gratis desde 30€) sigue activa,
# pero las reglas de categoría/peso (el antiguo fijo de 13€) quedan
# desactivadas por el propio schema.sql.
# Pedido agrupado: AFT permite agrupar productos en un mismo pedido, pero el
# coste depende del peso y todavía no hay una tarifa verificada. El agente
# NUNCA inventa ese coste ni suma los portes individuales como sustituto:
# solo muestra el peso total y lo marca «Pendiente de cotización» hasta que
# se confirme una tarifa real para pedidos agrupados.
# PVP máximo (€) para marcar un producto con margen suficiente como
# candidato a venta complementaria en vez de venta individual destacada.
# Opcional, por defecto 15 — puramente informativo, no cambia coste/margen.
# RENTABILIDAD_PVP_COMPLEMENTO_MAX=15

# --- Automatización (prioridad 2) ---
# Programa el pipeline completo (importar AFT -> sincronizar Shopify ->
# rentabilidad) una vez al día, a la hora indicada en formato "HH:MM", hora
# local de Europe/Madrid (gestiona el cambio de horario verano/invierno
# automáticamente). DESACTIVADO por defecto — no definir esta variable
# significa que nada se ejecuta solo; el pipeline solo corre cuando se
# lanza desde el panel o la API.
# PIPELINE_SCHEDULE_HORA_MADRID=10:00

# --- Shopify ---
SHOPIFY_SHOP=kb9i0z-da.myshopify.com
SHOPIFY_API_VERSION=2026-10
SHOPIFY_MAIN_LOCATION_ID=gid://shopify/Location/102229836040
# JSON con el cuerpo EXACTO que espera el POST de oauth/access_token de Shopify. Ejemplo:
#   {"grant_type":"client_credentials","client_id":"...","client_secret":"..."}
SHOPIFY_TOKEN_BODY_JSON=
# Tamaño de página al paginar TODO el catálogo de variantes (getAllVariants).
# Opcional, por defecto 25 — ajustar solo si el throttleStatus de Shopify
# (ver /api/sync-run/estado) muestra margen de sobra o, al revés, 429 frecuentes.
SHOPIFY_VARIANTS_PAGE_SIZE=25

# --- Reposición automática de stock (Agente 2, paso 2) ---
# DESACTIVADA (modo simulación / "dry run") por defecto — no definir esta
# variable (o dejarla distinta de "true") significa que el agente SOLO
# calcula y registra lo que haría, sin llamar nunca a Shopify para escribir.
# Antes de poner esto a "true" en producción: (1) concede el scope
# write_inventory a la app de Shopify, (2) valida varias ejecuciones en
# dry run contra datos reales y revisa su historial en el dashboard
# (Coincidencias > Reposición automática de stock), (3) solo entonces
# actívalo con autorización expresa. Aunque esté en "true", el agente
# vuelve a comprobar el scope write_inventory en cada ejecución y se queda
# en dry run si no lo tiene concedido — nunca lo asume.
# SHOPIFY_WRITE_ENABLED=true

# --- Oportunidades comerciales (Agente 4) ---
# Puntuación explicable (marca prioritaria + margen proyectado + stock,
# sobre 100 puntos) — todos opcionales, con valores de partida razonables.
# PVP a partir del cual una oportunidad con margen suficiente se marca
# como candidata a venta complementaria (igual criterio que en rentabilidad).
# OPORTUNIDADES_PVP_COMPLEMENTO_MAX=15
# Peso de cada componente del score (deben sumar 100 entre los tres).
# OPORTUNIDADES_PESO_MARCA_PRIORITARIA=40
# OPORTUNIDADES_PESO_MARGEN_MAX=40
# OPORTUNIDADES_PESO_STOCK_MAX=20
# Margen (%) y stock (uds.) a partir de los cuales su componente del score satura.
# OPORTUNIDADES_MARGEN_REFERENCIA=50
# OPORTUNIDADES_STOCK_REFERENCIA=20

# --- Demanda y SEO (Agente 5) ---
# DESCONECTADO por defecto — sin estas credenciales, el agente solo genera
# candidatos de keyword a partir del catálogo (marca+categoría+descripción),
# siempre marcados "sin verificar", nunca con un volumen de búsqueda
# inventado. Con las credenciales de DataForSEO (https://app.dataforseo.com/
# api-access) configuradas, consulta volumen y competencia reales para esas
# mismas keywords. La integración está construida contra la documentación
# pública de DataForSEO pero no se ha podido validar contra una cuenta real
# en este entorno — verifica una respuesta real antes de confiar en ella en
# producción.
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
# DATAFORSEO_LOCATION_NAME=Spain
# DATAFORSEO_LANGUAGE_CODE=es
# Límite de keywords consultadas por ejecución (controla el coste de la
# llamada externa). Opcional, por defecto 50.
# DEMANDA_MAX_KEYWORDS=50
